# Groq (free tier): create a key at https://console.groq.com/keys
GROQ_API_KEY=gsk_...
LLM_MODEL=llama-3.3-70b-versatile

# Optional overrides for another OpenAI-compatible provider:
# LLM_API_KEY=...
# LLM_BASE_URL=https://api.example.com/v1
# LLM_MODEL=model-name
# No key -> rule-based mock model is used automatically (USE_MOCK=auto)
# USE_MOCK=auto
# AGENT_MODE=a2   (a1 = Assignment 1 baseline, a2 = Assignment 2 safe agent)

# Set private local demo credentials in .env.local; do not commit that file.
# STUDENT_DEMO_PASSWORD=
# STAFF_DEMO_PASSWORD=
